{
  "name": "RDPs Place",
  "short_name": "RDPs Place",
  "description": "Touch-friendly offline information kiosk for cottage guests.",
  "start_url": "/",
  "display": "fullscreen",
  "background_color": "#f7f2e7",
  "theme_color": "#f7f2e7",
  "icons": [
    {
      "src": "/assets/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "id": "/index.html",
  "scope": "/",
  "display_override": [
    "fullscreen",
    "standalone"
  ]
}
